{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doc Studio",
  "version": "1.0.0",
  "identifier": "com.docstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Doc Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A document workbench for Markdown, HTML, JSON, XML, XFA/XDP & cURL",
    "longDescription": "Doc Studio is a document workbench: edit and convert Markdown, HTML, JSON and XML; extract XFA (XDP) XML from dynamic PDFs; run and organise cURL requests with saved envelopes, response history and multipart file upload — all in one keyboard-friendly UI."
  }
}
