{
  "name": "doc-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Doc Studio — a document + API workbench for Markdown, HTML, JSON, XML, XFA/XDP and cURL requests, with PDF export and multipart upload support.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "postinstall": "node scripts/patch-latexjs.mjs",
    "prebuild": "npm run gen:icons",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "start": "tsx server/index.ts",
    "docker:build": "docker build -t doc-studio .",
    "docker:run": "docker run --rm -p 8080:8080 doc-studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon public/icons/icon.svg",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "npm run build && cap add android",
    "cap:add:ios": "npm run build && cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "npm run build && cap sync android && cap run android",
    "cap:run:ios": "npm run build && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.5",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "express": "^4.19.2",
    "framer-motion": "^11.11.9",
    "highlight.js": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "latex.js": "^0.12.6",
    "localforage": "^1.10.0",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.8.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.9",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "svg2pdf.js": "^2.7.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.25",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.0",
    "typescript": "^5.6.2",
    "undici": "^8.7.0",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
